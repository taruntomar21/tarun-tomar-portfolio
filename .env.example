# Copy to .env for LOCAL development. Never commit a real .env.
APP_ENV=development
SECRET_KEY=replace-with-output-of-python-secrets-token-hex
DATABASE_URL=sqlite:///portfolio.db
SITE_URL=http://127.0.0.1:5000
TRUST_PROXY=false

# local is DEVELOPMENT ONLY. Production refuses local uploads and SQLite.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Development memory limiter; production REQUIRES redis:// or rediss://
RATELIMIT_STORAGE_URI=memory://

# Admin email/password are deliberately NOT read from env.
# Create the account using: flask --app app:create_app create-admin
# Email notification delivery is not implemented; messages persist in the inbox.
